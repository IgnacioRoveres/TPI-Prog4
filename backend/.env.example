# Copiar este archivo como .env y completar los valores. El .env no se entrega.

# PostgreSQL (crear antes la base foodstore_db). Para desarrollo se acepta SQLite:
#   DATABASE_URL=sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db

# Clave para firmar los JWT: al menos 32 caracteres. Para generar una:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

ALGORITHM=HS256

# Vencimiento del token y de la cookie, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
